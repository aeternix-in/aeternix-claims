# Copy to .env. Never commit .env.

# --- required
DB_OWNER_PASSWORD=change-me-owner
DB_APP_PASSWORD=changemeapp123          # letters and digits only: it is passed to psql on the command line
SECRET_KEY=                             # python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_MODE=false                         # true adds the synthetic demo hospital and the /mock-portal fixture

# --- strongly recommended: encrypt stored claim documents at rest
FILE_ENCRYPTION_KEY=                    # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- optional integrations (all off by default)
OCR_PROVIDER=auto                       # auto = local tesseract | none
LLM_PROVIDER=none                       # none | anthropic  (text is redacted before it is sent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
NOTIFY_PROVIDER=console                 # console | smtp | whatsapp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=digest@aeternix.in
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=                      # an approved template name; business-initiated messages need one

# --- Aeternix business settings (not scheme rules; those live in the rule packs)
HIGH_VALUE_THRESHOLD_PAISE=10000000     # Rs 1 lakh: replies above this need a second look
RECON_TOLERANCE_PAISE=100
RECON_DATE_WINDOW_DAYS=10
BANK_CREDIT_EXPECTED_DAYS=7
CLAIM_WINDOW_WARNING_DAYS=3
DIGEST_HOUR=8
CORS_ORIGINS=
TOKEN_TTL_HOURS=12
